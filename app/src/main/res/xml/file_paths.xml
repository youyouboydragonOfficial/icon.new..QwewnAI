<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外部ストレージのダウンロードフォルダ -->
    <external-path
        name="downloads"
        path="Download/" />
    
    <!-- アプリ固有のダウンロードフォルダ -->
    <external-files-path
        name="app_downloads"
        path="downloads/" />
    
    <!-- アイコン保存フォルダ -->
    <files-path
        name="icons"
        path="icons/" />
    
    <!-- キャッシュフォルダ -->
    <cache-path
        name="cache"
        path="/" />
</paths>
